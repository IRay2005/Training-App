{
  "name": "adaptive-training-system",
  "private": true,
  "workspaces": [
    "server",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:mobile": "npm run start --workspace mobile",
    "build:server": "npm run build --workspace server",
    "start:server": "npm run start --workspace server",
    "build:web": "npm run build:web --workspace mobile"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
